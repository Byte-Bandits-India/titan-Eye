# ==========================================
# TITAN EYE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env for local development
# ==========================================
NODE_ENV=development
PORT=3001

# Security & Secrets
JWT_SECRET=your-jwt-secret
WEBHOOK_SECRET=your-webhook-secret
INTER_SERVER_SECRET=your-inter-server-secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Admin Default Credentials
ADMIN_EMAIL=admin@thebytebandits.onmicrosoft.com
ADMIN_PASSWORD=your-admin-password

# Frontend & API URLs
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_LOCAL_SERVICE_URL=http://localhost:3001/api

# Microsoft Entra ID (Azure AD) SSO
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback

# Azure Communication Services (ACS) & Microsoft Teams
ACS_CONNECTION_STRING=
ACS_ENDPOINT=
TEAMS_MEETING_ORGANIZER_UPN=


# Log Storage Encryption (AES-256-GCM)
LOG_ENCRYPTION_ENABLED=true
LOG_ENCRYPTION_KEY=your-64-character-hex-encryption-key
