# Titan Remote Vision Care - Production Environment Variables Template (https://titan.thebytebandits.com)

NODE_ENV=production

# Security Keys
JWT_SECRET=your-production-jwt-secret-key-here
WEBHOOK_SECRET=your-production-webhook-secret-here

# CORS & Domain Settings
ALLOWED_ORIGINS=https://titan.thebytebandits.com
FRONTEND_URL=https://titan.thebytebandits.com
VITE_API_BASE_URL=https://titan.thebytebandits.com/api
VITE_LOCAL_SERVICE_URL=https://titan.thebytebandits.com/api

# Initial Seed Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SetAStrongPassword123!

# Microsoft Entra ID (Azure AD) SSO (Optional - leave blank if unused)
ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_CLIENT_SECRET=your-client-secret-here
ENTRA_REDIRECT_URI=https://titan.thebytebandits.com/api/auth/microsoft/callback

# Logging
# LOG_LEVEL: error | warn | info | http | debug (default: info in production)
LOG_LEVEL=info
# LOG_DIR: directory for rotated log files (app-*.log, error-*.log, security-*.log).
# Must be writable by the server process and outside any web-served/static path.
LOG_DIR=logs

# Optional: ship every log line to a syslog-compatible collector (rsyslog,
# Fluentd, Graylog, or a Splunk/ELK/CloudWatch agent listening on syslog
# input). Leave SYSLOG_HOST blank to keep logs local-file-only.
# SYSLOG_HOST=
# SYSLOG_PORT=514
# SYSLOG_PROTOCOL=udp4

# Optional: POST a message to this URL (Slack or Microsoft Teams incoming
# webhook — both accept a plain { "text": ... } body) when something critical
# happens: uncaught exceptions, DB init failure, account lockouts, invalid
# webhook signatures. Leave blank to disable — alerts still get logged either way.
# ALERT_WEBHOOK_URL=
