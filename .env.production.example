# ==========================================
# TITAN EYE - PRODUCTION ENVIRONMENT TEMPLATE (.env)
# Domain: trvc.titan.in
# ==========================================
NODE_ENV=production
PORT=3001

# Security & Secrets (Replace with secure random keys in production)
JWT_SECRET=your-production-jwt-secret
WEBHOOK_SECRET=your-production-webhook-secret
INTER_SERVER_SECRET=your-production-inter-server-secret
ALLOWED_ORIGINS=https://trvc.titan.in

# Admin Default Credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=your-secure-admin-password

# Frontend & API URLs
FRONTEND_URL=https://trvc.titan.in
VITE_API_BASE_URL=/api
VITE_LOCAL_SERVICE_URL=https://trvc.titan.in/api

# Microsoft Entra ID (Azure AD) SSO
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://trvc.titan.in/api/auth/microsoft/callback

# Azure Communication Services (ACS) & Microsoft Teams
ACS_CONNECTION_STRING=
ACS_ENDPOINT=
TEAMS_MEETING_ORGANIZER_UPN=

# Log Storage Encryption (AES-256-GCM)
LOG_ENCRYPTION_ENABLED=true
LOG_ENCRYPTION_KEY=your-64-character-hex-encryption-key
